# ---------------------------------------------------------------------------
# OCI MCP server configuration. Copy to .env or export in your shell.
# Every value here is optional; the defaults fail closed.
# ---------------------------------------------------------------------------

# Profile inside ~/.oci/config to authenticate with.
OCI_CLI_PROFILE=DEFAULT

# Override the region from the profile. Leave unset to use the profile's region.
#OCI_MCP_REGION=us-ashburn-1

# --- Capability flags -------------------------------------------------------
# Tools are registered conditionally: when a flag is false the corresponding
# tools are ABSENT from the catalog, not merely refusing when called.
OCI_MCP_ALLOW_WRITE=true
OCI_MCP_ALLOW_DELETE=false

# --- Compartment allowlist --------------------------------------------------
# Comma-separated compartment names or OCIDs. Every mutating call resolves its
# target's compartment and is rejected if it falls outside this list.
# EMPTY MEANS NO MUTATION IS PERMITTED ANYWHERE (fail closed).
# Use a disposable compartment here, never root.
OCI_MCP_COMPARTMENTS=lab

# --- Audit ------------------------------------------------------------------
#OCI_MCP_AUDIT_LOG=~/.oci-mcp/audit.jsonl
